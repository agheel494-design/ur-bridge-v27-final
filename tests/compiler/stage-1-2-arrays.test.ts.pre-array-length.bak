describe("Stage 1.2 Arrays � empty array behavior", () => {
  it("typed empty array literal int[] executes zero loop iterations", async () => {
    const { r } = await compileAndRun(
      'function main(): int\n' +
      '  let arr: int[] = []\n' +
      '  let count: int = 0\n' +
      '  for item in arr\n' +
      '    count = count + 1\n' +
      '  end\n' +
      '  print(count)\n' +
      '  return count\n' +
      'end\n'
    );
    expect(r.exitCode).toBe(0);
    expect(r.stdout.trim()).toBe("0");
  });
});
