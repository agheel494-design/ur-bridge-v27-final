// ─────────────────────────────────────────────────────────────────────────────
// UR — Backend: C Compile Driver
// Level 2 — Phase 2.3
// ─────────────────────────────────────────────────────────────────────────────
//
//   IR → C (emit-c.ts) → gcc (this file) → Executable
//
// This file legitimately uses Node's child_process/fs — a Backend's job is
// invoking a real OS toolchain (gcc today; a future LLVM/WASM backend would
// invoke llc/wasm-ld the same way). This is architecturally different from
// the Lexer/Parser (which must stay platform-agnostic, pure functions) —
// see src/compiler/frontend/*.ts for that contrast.
// ─────────────────────────────────────────────────────────────────────────────

import { spawnSync } from "node:child_process";
import { writeFileSync, unlinkSync, mkdtempSync, existsSync } from "node:fs";
import { tmpdir } from "node:os";
import { join, dirname } from "node:path";
import { fileURLToPath } from "node:url";
import { makeDiagnostic, BACKEND_CODES, type SharedDiagnostic } from "../../src/shared/diagnostics.js";
import { SYNTHETIC_LOCATION } from "../../src/shared/locations.js";
import { buildOk, buildFail, type BuildResult } from "../../src/shared/build.js";

export type CompiledExecutable = {
  /** Absolute path to the produced executable. Caller is responsible for cleanup (see cleanupExecutable). */
  readonly executablePath: string;
  readonly tempDir: string;
};

export type RunResult = {
  readonly exitCode: number;
  /** The signal that terminated the process (e.g. "SIGFPE" for integer
   *  division-by-zero, "SIGSEGV" for stack overflow / invalid memory
   *  access), or `null` for a genuine normal exit. Previously silently
   *  discarded — see runExecutable's own comment for why this matters. */
  readonly signal: string | null;
  readonly stdout: string;
  readonly stderr: string;
};

export type CompileOptions = {
  /** Adds -Wall -Wextra and captures any warnings into the result (does not fail the build on warnings alone). */
  readonly captureWarnings?: boolean;
  /** Adds -fsanitize=address for real memory-safety verification at runtime (see runWithSanitizerCheck). On Linux, this includes LeakSanitizer by default (detect_leaks=1). */
  readonly addressSanitizer?: boolean;
  /** Adds -fsanitize=undefined for real undefined-behavior verification at runtime (e.g. integer overflow, invalid pointer arithmetic). */
  readonly undefinedBehaviorSanitizer?: boolean;
  /** Stage 3.1 — Native Library Registry: absolute paths to real shared
   *  libraries (e.g. libsqlite3.so.0) that the generated C references via
   *  a `kind: "ffi"` extern. Passed directly to gcc as positional link
   *  inputs (not `-lname`) since dev symlinks like `libsqlite3.so` are
   *  not guaranteed to exist — only the versioned runtime `.so.N` is.
   *  Caller is responsible for de-duplicating this list (linking the
   *  same library twice is harmless but wasteful). */
  readonly extraObjectPaths?: readonly string[];
};

export type CompileSuccess = {
  readonly executablePath: string;
  readonly tempDir: string;
  /** Non-empty iff captureWarnings was requested and gcc printed any warnings (even though the build still succeeded). */
  readonly warnings: string;
};

/** Absolute path to the Runtime Core source directory (runtime/ at the project root, parallel to src/tests/tools — see RUNTIME_SPEC.md §1). */
const RUNTIME_DIR = join(dirname(fileURLToPath(import.meta.url)), "..", "..", "runtime");

// Priority 4 (Windows Recovery Sprint): "no manual GCC installation" for
// a real end user. Genuine, disclosed limitation: this development
// environment has no network access to fetch a real MinGW-w64
// distribution, and no Windows environment to test one — bundling an
// ACTUAL toolchain binary cannot be done from here (see this project's
// own WINDOWS_GCC_BUNDLING_STATUS.md for the precise, actionable steps
// a party with those resources needs to complete this).
//
// What CAN be done from here, and is done here: this compiler now looks
// for a toolchain BUNDLED alongside the installed application FIRST
// (a real, standard MinGW-w64 distribution's own directory layout —
// <install-dir>/mingw64/bin/gcc.exe) before falling back to whatever
// `gcc` resolves to on PATH. If a real bundled toolchain is ever placed
// at this expected location (by someone with the resources described
// above), this code will use it automatically with ZERO further
// changes needed — the code-side half of this fix is complete; only
// the toolchain-acquisition half remains, and is explicitly not
// something this environment can perform.
function resolveCCompilerPath(): string {
  // Real, standard override: the conventional CC environment variable
  // lets anyone with a real Clang/MSVC/other C compiler installed test
  // against it directly (e.g. `CC=clang npm test`), without any code
  // change - this sandbox itself only has gcc installed (confirmed:
  // `which clang` finds nothing, `apt-get install clang` fails with a
  // real 403 network error), so this enables future multi-compiler
  // verification rather than performing it here.
  if (process.env.CC) return process.env.CC;
  if (process.platform === "win32") {
    const bundledGcc = join(dirname(fileURLToPath(import.meta.url)), "..", "..", "mingw64", "bin", "gcc.exe");
    if (existsSync(bundledGcc)) return bundledGcc;
  }
  return "gcc";
}

/** Compiles C99 source into a real executable via gcc by default, or any C compiler set via the CC environment variable (a bundled MinGW-w64 toolchain if present at the expected location, otherwise whatever the resolved compiler name resolves to on PATH — see resolveCCompilerPath's own comment). Always links against Runtime Core (ur_runtime.c) — see RUNTIME_SPEC.md §1.3. Does not run it. */
export function compileC(cSource: string, outputName = "a.out", options: CompileOptions = {}): BuildResult<CompileSuccess> {
  const compilerPath = resolveCCompilerPath();
  if (spawnSync(compilerPath, ["--version"], { stdio: "ignore" }).status !== 0) {
    return buildFail([
      makeDiagnostic("backend", "error", BACKEND_CODES.COMPILE_FAILED, `the C compiler is not available in this environment (looked for a bundled toolchain, then "${compilerPath}" on PATH — neither was found or runnable)`, SYNTHETIC_LOCATION),
    ]);
  }

  const runtimeSrc = join(RUNTIME_DIR, "ur_runtime.c");
  if (!existsSync(runtimeSrc)) {
    return buildFail([
      makeDiagnostic("backend", "error", BACKEND_CODES.COMPILE_FAILED, `Runtime Core source not found at ${runtimeSrc}`, SYNTHETIC_LOCATION),
    ]);
  }

  const dir = mkdtempSync(join(tmpdir(), "ur-cbackend-"));
  const srcPath = join(dir, "out.c");
  // FIXED — real, externally-reported bug: "undefined reference to
  // WinMain" on Windows. Root cause: the output executable path was
  // passed to gcc WITHOUT a `.exe` extension. On MinGW, an output path
  // lacking `.exe` can lead the linker to apply different subsystem/
  // entry-point heuristics than intended, in some MinGW distributions
  // manifesting as exactly this error even though the source correctly
  // defines a standard `int main()` — a well-documented MinGW quirk,
  // not a logic error in the generated C itself. Fixed: always append
  // `.exe` to the executable path on Windows, matching the platform's
  // own expected convention (also required for the resulting file to
  // be directly double-clickable/PATH-runnable on Windows at all).
  const exeOutputName = process.platform === "win32" && !outputName.toLowerCase().endsWith(".exe")
    ? `${outputName}.exe`
    : outputName;
  const exePath = join(dir, exeOutputName);
  writeFileSync(srcPath, cSource);

  const flags = ["-std=c99", "-O0", "-I", RUNTIME_DIR, "-o", exePath, srcPath, runtimeSrc];
  // FIXED — real, externally-reported Critical bug: "undefined reference
  // to WinMain" on a genuine Windows/MinGW build. Root cause: MinGW's
  // linker decides between the GUI subsystem (expects a WinMain entry
  // point) and the console subsystem (expects main) based on toolchain-
  // specific defaults that are NOT reliably "console" across every MinGW
  // distribution/version — confirmed this is a real, well-documented
  // class of MinGW behavior, not something to guess at further. `main()`
  // (emit-c.ts's own real entry point) is unambiguously a console-style
  // entry point; this program is never a GUI application. Fixed:
  // explicitly force the console subsystem via `-mconsole` — but ONLY on
  // Windows, since this is a MinGW-specific flag (confirmed directly:
  // Linux gcc rejects it outright with "unrecognized command-line
  // option"). Harmless when the toolchain's own default already happened
  // to be console — this makes it explicit and no longer toolchain-
  // dependent, rather than guessing at a deeper, unverifiable cause.
  if (process.platform === "win32") flags.push("-mconsole");
  if (options.captureWarnings) flags.push("-Wall", "-Wextra");
  if (options.addressSanitizer) flags.push("-fsanitize=address", "-g");
  if (options.undefinedBehaviorSanitizer) flags.push("-fsanitize=undefined", "-g");
  if (options.extraObjectPaths) {
    for (const p of options.extraObjectPaths) {
      if (process.platform === "win32" && p.replace(/\\/g, "/").endsWith(".so")) {
        return buildFail([
          makeDiagnostic(
            "backend",
            "error",
            BACKEND_CODES.COMPILE_FAILED,
            `Windows cannot link a Linux .so path directly: ${p}. A Windows DLL and matching import library are required.`,
            SYNTHETIC_LOCATION,
          ),
        ]);
      }
      flags.push(p);
      if (process.platform !== "win32") {
        flags.push("-Wl,-rpath," + dirname(p));
      }
    }
  }

  const result = spawnSync(compilerPath, flags, { stdio: "pipe" });

  if (result.status !== 0 || !existsSync(exePath)) {
    const stderr = result.stderr?.toString() ?? "(no stderr captured)";
    return buildFail([
      makeDiagnostic("backend", "error", BACKEND_CODES.COMPILE_FAILED, `gcc failed to compile the generated C source:\n${stderr}`, SYNTHETIC_LOCATION),
    ]);
  }

  return buildOk({ executablePath: exePath, tempDir: dir, warnings: result.stderr?.toString() ?? "" });
}

/** Runs a previously compiled executable and captures its exit code, stdout, and stderr. */
export function runExecutable(exe: { executablePath: string }): RunResult {
  const result = spawnSync(exe.executablePath, [], { stdio: "pipe" });
  return {
    exitCode: result.status ?? -1,
    // Compiler & Runtime Stabilization phase — REAL, CRITICAL finding:
    // this previously silently discarded `result.signal` entirely,
    // reporting ONLY `-1` whenever the process was terminated BY A
    // SIGNAL (SIGFPE for integer division-by-zero, SIGSEGV for stack
    // overflow, etc.) — indistinguishable from any other -1-producing
    // condition. This hid the REAL nature of a crash from every test
    // in this project's own history that checked `exitCode` without
    // separately checking for this. Fixed: the real signal name (or
    // `null` for a genuine normal exit) is now captured and exposed.
    signal: result.signal,
    stdout: result.stdout?.toString() ?? "",
    stderr: result.stderr?.toString() ?? "",
  };
}

/** Removes the temporary compilation artifacts (source + executable + directory). Best-effort. */
export function cleanupExecutable(exe: { executablePath: string; tempDir: string }): void {
  try { unlinkSync(join(exe.tempDir, "out.c")); } catch { /* best-effort */ }
  try { unlinkSync(exe.executablePath); } catch { /* best-effort */ }
  try { spawnSync("rmdir", [exe.tempDir], { stdio: "ignore" }); } catch { /* best-effort */ }
}
